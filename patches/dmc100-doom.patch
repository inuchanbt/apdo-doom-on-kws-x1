 def _dwarf_enums(obj):
     """{typedef name: [(enumerator, value)]} from llvm-dwarfdump text output."""
+    if os.name == "nt" and not shutil.which(DWARFDUMP):
+        # LLVM-MinGW omits dwarfdump. Ask the same compiler for its evaluated
+        # enum declarations instead; this still uses the pinned upstream types.
+        ast = json.loads(_run([CC] + CFLAGS + ["-Xclang", "-ast-dump=json",
+                                             "-fsyntax-only", os.path.join(DUMPER_SRC, "dump_info.c")]))
+        enum_by_id = {}
+        typedefs = []
+        def visit(node):
+            if node.get("kind") == "EnumDecl" and "inner" in node:
+                value, vals = -1, []
+                for child in node["inner"]:
+                    if child.get("kind") != "EnumConstantDecl":
+                        continue
+                    value += 1
+                    for expr in child.get("inner", []):
+                        if expr.get("kind") == "ConstantExpr" and "value" in expr:
+                            value = int(expr["value"], 0)
+                    vals.append((child["name"], value))
+                enum_by_id[node["id"]] = vals
+            if node.get("kind") == "TypedefDecl":
+                typedefs.append(node)
+            for child in node.get("inner", []):
+                visit(child)
+        visit(ast)
+        out = {}
+        for node in typedefs:
+            pending = list(node.get("inner", []))
+            while pending:
+                child = pending.pop()
+                ref = child.get("ownedTagDecl", child.get("decl", {})).get("id")
+                if ref in enum_by_id:
+                    out[node["name"]] = enum_by_id[ref]
+                    break
+                pending.extend(child.get("inner", []))
+        return out
     text = _run([DWARFDUMP, "--debug-info", obj])
     entries = []
     cur = None
